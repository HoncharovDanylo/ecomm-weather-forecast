# Copy this file to .env and fill in the values
# .env is gitignored and should never be committed

# Database
DB_USER=postgres
DB_PASSWORD=admin
DB_NAME=forecast

# Connection string (built from the above values)
# Host must match the compose service name 'db'
DB_CONNECTION_STRING=Host=db;Port=5432;Database=forecast;Username=postgres;Password=admin

# API Keys
GEOCODING_API_KEY=your_geocoding_api_key_here
OPEN_WEATHER_API_KEY=your_openweather_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
INTERNAL_API_KEY=your_internal_api_key_here
