{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MainConfiguration" : {
    "GeocodingApiKey" : "*****",
    "OpenWeatherApiKey" : "*****",
    "TelegramBotToken"  : "******",
    "InternalApiKey"  : "*****",
    "IsTelegramIntegrationEnabled" : true,
    "TelegramBotApi" : "https://api.telegram.org/bot", 
    "OpenWeatherUrl" : "https://api.openweathermap.org/data/2.5/"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=*****:****;Database=forecast;User Id=*****;Password=****;"
  },
  "IsHangfireDashboardEnabled": true,
  "IsSwaggerDisabled": false,
  "AllowedHosts": "*",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/applog-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"],
    "Properties": {
      "ApplicationName": "Weather forecast"
    }
  }
}
